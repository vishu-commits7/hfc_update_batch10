{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "photos": "node tools/photo-manifest.mjs",
    "clips": "node tools/clips.mjs",
    "programs:check": "node tools/check-programs.mjs",
    "i18n:check": "node tools/check-i18n.mjs",
    "ghosts:check": "node tools/check-ghosts.mjs",
    "daily:check": "node tools/check-daily.mjs",
    "leagues:check": "node tools/check-leagues.mjs",
    "anticheat:check": "node tools/check-anticheat.mjs",
    "moderation:check": "node tools/check-moderation.mjs",
    "invites:check": "node tools/check-invites.mjs",
    "costs:check": "node tools/check-costs.mjs",
    "demo:check": "node tools/check-demo.mjs",
    "review:check": "node tools/check-review.mjs",
    "paywall:check": "node tools/check-paywall.mjs",
    "share:check": "node tools/check-share.mjs",
    "arch:check": "node tools/check-arch.mjs",
    "reps:check": "node tools/check-reps.mjs",
    "chat:check": "node tools/check-chat.mjs",
    "fetch:mediapipe": "node tools/fetch-mediapipe.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
