<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth and App Deep Linking (com.apex.fitness://oauth and com.homefitnesscoach.app://oauth) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.apex.fitness" android:host="oauth" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.homefitnesscoach.app" android:host="oauth" />
            </intent-filter>
            <!-- Invite links. (1) apexpulse://join?crew=CODE : used by the "Open in the app" button on the landing page.
                 (2) https://<host>/join?... : opens the app directly once /.well-known/assetlinks.json on that host
                 lists this app's signing certificate (ANDROID_CERT_SHA256 on the server). Until then Android shows
                 the landing page in the browser. If the link host changes (VITE_APP_SHARE_URL), change it here too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apexpulse" android:host="join" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hfc-update-batch10.onrender.com" android:pathPrefix="/join" />
            </intent-filter>
            <!-- Health Connect: lets the user see why the app reads steps/calories (required for the permission screen) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: Health Connect "Privacy policy" link in the permission screen opens the same rationale -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Health Connect read access (steps + active calories only). Needs the Health Connect app on Android 13 and below. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app camera + microphone for recording posts/reels and the form
         scanner. Without these, getUserMedia() always fails inside the
         WebView, which is why "record from camera" fell through to the
         gallery picker. Capacitor's WebView asks for the runtime permission
         when the page requests the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Tactile feedback. src/lib/haptics.ts falls back to
         navigator.vibrate() when the Capacitor haptics plugin is not
         installed; without this the fallback silently no-ops.
         Normal permission - no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Daily workout reminder / streak warning / hydration nudge.
         @capacitor/local-notifications already merges this in from its own
         manifest, so the build works without the line. It is declared here
         anyway because a permission the app actually asks the user for
         should be readable in the app's own manifest rather than only in a
         merged dependency - this is the file anyone reviewing the app opens.
         Android 13+ (API 33) prompts at runtime; the request is made by
         requestNotificationPermission() in src/lib/notifications.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms: deliberately NOT shipped.

         @capacitor/local-notifications declares SCHEDULE_EXACT_ALARM in its
         own manifest and defaults every notification to isExactNotification
         = true. Left alone, the first time a user enables a reminder the
         plugin launches the system "Alarms & reminders" settings screen to
         collect that permission - which Android 14+ denies by default for
         anything targeting API 33 or higher (this app targets 36). Every
         user would be thrown out of the app into Settings to schedule a
         workout nudge.

         src/lib/notifications.ts sets isExactNotification: false on all
         three reminders instead, so they schedule as inexact alarms with no
         prompt and no interruption. None of them need to fire to the
         precise minute, and inexact alarms are far kinder to the battery.

         Since the permission is never used, it is stripped from the merged
         manifest so it does not appear in the Play listing or pull the app
         into a sensitive-permissions review.

         To reintroduce exact alarms: delete this line AND remove the
         INEXACT spread in src/lib/notifications.ts. Doing only one of the
         two leaves the app either prompting for a permission it cannot get,
         or holding a permission it never uses. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
