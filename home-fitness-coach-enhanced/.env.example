# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: This key is only ever read on the server (server.ts). It must
# never be prefixed with VITE_ or referenced from client code — any env var
# prefixed VITE_ gets bundled into the public JS shipped to the browser.
GEMINI_API_KEY="AQ.Ab8RN6KDT-rcLO7wrmZ3tv586e9VyTmcyNm6TCoWssko_hgR4g"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_SHARED_SECRET (optional, server-side only): if set, the AI-generate
# endpoint rejects any request that doesn't carry a matching x-app-secret
# header. Not strong security (see the comment on checkSharedSecret in
# server.ts) but stops random bots/scanners that find the deployed URL
# from quietly burning through your Gemini quota. Leave blank to disable.
# If you set this, VITE_API_SHARED_SECRET below must be the exact same value.
API_SHARED_SECRET=""

# --- Settings for the INSTALLED ANDROID/iOS APP build only ---
# The compiled app has no server of its own, so it needs to know the real,
# already-deployed backend URL to call for AI workout generation (see
# src/lib/apiBase.ts). Leave both blank for local `npm run dev` / web
# preview — those hit this same server automatically.

# VITE_API_BASE_URL: the base URL of your deployed server.ts backend
# (e.g. a Render web service: "https://your-app-name.onrender.com").
# No trailing slash. Baked into the app at build time — set this before
# running `npm run build` for a native build.
VITE_API_BASE_URL=""

# VITE_API_SHARED_SECRET: must exactly match API_SHARED_SECRET above,
# configured as an environment variable on the deployed server (never
# commit the real value to source control either way).
VITE_API_SHARED_SECRET=""
