# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Anything prefixed VITE_ is baked into the compiled JavaScript at build
# time and is PUBLIC — it ships inside the APK and anyone can read it.
# Never put a secret behind a VITE_ prefix.

# ---------------------------------------------------------------------
# REQUIRED for any build you install on a phone
# ---------------------------------------------------------------------

# Where the app sends AI workout-generation requests.
#
# The installed app ships only the compiled frontend — there is no server
# on the device — so a relative `/api/...` call resolves to the WebView's
# own index.html and the generator fails with a JSON parse error. Deploy
# server.ts somewhere reachable from a phone (Render, Railway, Cloud Run)
# and point this at it.
#
# `npm run build` refuses to run without this. If you are deliberately
# building the plain web version, where /api is served from the same
# origin, use: ALLOW_MISSING_API_BASE=1 npm run build
VITE_API_BASE_URL=https://your-backend.example.com

# ---------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------

# Sent as `x-app-secret` with API requests. Only useful when the backend
# has API_SHARED_SECRET set to the same value. It raises the cost of
# casual abuse of your Gemini quota; it is NOT authentication, because it
# ships inside the app like everything else prefixed VITE_.
# VITE_API_SHARED_SECRET=

# ---------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix these with VITE_
# ---------------------------------------------------------------------

# Read by server.ts only. Prefixing it VITE_ would publish your Gemini
# key inside the app to every user who installs it.
# GEMINI_API_KEY=
# API_SHARED_SECRET=
